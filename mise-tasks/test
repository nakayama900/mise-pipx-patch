#!/usr/bin/env bash
#MISE description="Run pipx-patch backend plugin tests"
set -euo pipefail

# Link the plugin for development/testing
mise plugin link --force pipx-patch .

# Clear cache to ensure fresh testing
mise cache clear

TEST_TOOL="black"

echo "=== Testing version listing for ${TEST_TOOL} ==="
if mise ls-remote "pipx-patch:${TEST_TOOL}" 2>/dev/null | tail -5; then
    echo "✓ Version listing works"
else
    echo "✗ Version listing failed" >&2
    exit 1
fi

echo ""
echo "=== Testing installation of ${TEST_TOOL}@latest ==="
if mise install "pipx-patch:${TEST_TOOL}@latest"; then
    echo "✓ Installation works"
else
    echo "✗ Installation failed" >&2
    exit 1
fi

echo ""
echo "=== Testing tool execution ==="
if mise exec "pipx-patch:${TEST_TOOL}@latest" -- black --version; then
    echo "✓ Tool execution works"
else
    echo "✗ Tool execution failed" >&2
    exit 1
fi

echo ""
echo "=== All tests passed ==="